    "scenario": {
      "intro": {
        "lines": [
          {
            "speaker": "",
            "portraitId": "",
            "text": "바다를 건너는 동안, 병사들은 같은 이름을 되뇌었다. 트로이. 누군가에게는 되찾을 명예였고, 누군가에게는 나눠 가질 전리품이었다."
          },
          {
            "speaker": "",
            "portraitId": "",
            "text": "아직 그곳을 집이라고 부르는 사람의 목소리는 들리지 않았다."
          },
          {
            "speaker": "그리스 창병",
            "portraitId": "greek-spear",
            "text": "저게 트로이입니까? 생각보다… 조용하네요."
          },
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "성은 더 안쪽이다. 아무도 없는 해변이면 좋겠는데."
          },
          {
            "speaker": "아킬레우스",
            "portraitId": "achilles",
            "text": "방패를 들어. 저 바위 위에 사람이 있다."
          },
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "손목의 조개… 아직 차고 있네."
          },
          {
            "speaker": "아킬레우스",
            "portraitId": "achilles",
            "text": "어머니가 매듭을 세게 묶었어. ……돌아가면 직접 풀어 달라고 해야지."
          },
          {
            "speaker": "트로이 창병 1",
            "portraitId": "trojan-spear-1",
            "text": "대장님. 배가 더 옵니다. 마지막 수레가 아직 언덕 아래에 있습니다."
          },
          {
            "speaker": "디오레스",
            "portraitId": "diores",
            "text": "그럼 여기서 버틴다. 성으로 가는 길을 비워 둬."
          },
          {
            "speaker": "트로이 창병 1",
            "portraitId": "trojan-spear-1",
            "text": "저 숫자를 막으라고요?"
          },
          {
            "speaker": "디오레스",
            "portraitId": "diores",
            "text": "다 막을 필요 없어. 저 수레가 언덕을 넘을 때까지만."
          },
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "명령은 상륙로 확보야. 혼자 성까지 달려갈 생각은 하지 마."
          },
          {
            "speaker": "아킬레우스",
            "portraitId": "achilles",
            "text": "내가 길을 열게. 넌 뒤를 부탁해."
          },
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "뒤에 있는 사람들 이름부터 기억해 둬."
          }
        ],
        "bg": "troia-opening"
      },
      "outro": {
        "lines": [
          {
            "speaker": "그리스 창병",
            "portraitId": "greek-spear",
            "text": "쫓습니까?"
          },
          {
            "speaker": "아킬레우스",
            "portraitId": "achilles",
            "text": "아니. 배를 올려. 다친 사람부터 내려라."
          },
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "저 사람들은 널 막으려던 게 아니었어."
          },
          {
            "speaker": "아킬레우스",
            "portraitId": "achilles",
            "text": "알아. 시간을 벌고 있었지."
          },
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "무엇을 위해?"
          },
          {
            "speaker": "아킬레우스",
            "portraitId": "achilles",
            "text": "……우리도 배에 두고 온 게 있잖아."
          },
          {
            "speaker": "",
            "portraitId": "",
            "text": "그날, 그리스군은 해변 하나를 얻었다. 해변에서 떠난 사람들은 돌아갈 길 하나를 잃었다. 전쟁은 그렇게, 서로 다른 이름으로 시작되었다."
          }
        ],
        "bg": "troia-coast"
      },
      "outroDefeat": {
        "lines": [
          {
            "speaker": "아킬레우스",
            "portraitId": "achilles",
            "text": "다친 사람을 배로 옮겨. 내가 막는다."
          },
          {
            "speaker": "",
            "portraitId": "",
            "text": "상륙대는 배로 물러났다. 아직 돌아올 기회는 남아 있다."
          }
        ],
        "bg": "troia-coast"
      }
    },
    "dialogue": [
      {
        "id": "troia-start",
        "trigger": {
          "kind": "battleStart"
        },
        "lines": [
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "동쪽 해안길을 따라 봉화대(34, 8)로 향하자. 화면을 끌어 전장을 살펴봐. 나란히 붙어 협공하고, 다친 동료는 책략과 붕대로 돌봐 줘."
          }
        ]
      },
      {
        "id": "civilians",
        "trigger": {
          "kind": "turn",
          "n": 4
        },
        "lines": [
          {
            "speaker": "그리스 궁병",
            "portraitId": "greek-archer",
            "text": "저쪽 길로 수레가 갑니다. 따라갈까요?"
          },
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "무기가 아니야. 사람을 싣고 있어."
          },
          {
            "speaker": "아킬레우스",
            "portraitId": "achilles",
            "text": "우리 목표는 봉화대다. 길을 벗어나지 마."
          }
        ]
      },
      {
        "id": "last-turn",
        "trigger": {
          "kind": "turn",
          "n": 20
        },
        "lines": [
          {
            "speaker": "파트로클로스",
            "portraitId": "patroclus",
            "text": "해변에서 더 버티면 포위돼. 봉화대를 확보해야 해!"
          }
        ]
      }
    ],
