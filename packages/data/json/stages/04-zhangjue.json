  "dialogue": [
    {
      "id": "04-zhangjue_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "장각",
          "side": "enemy",
          "text": "하늘이 한실을 버린 지 오래다. 백성의 분노가 곧 나의 군세이니라!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "백성을 앞세워 백성을 태우는 자가, 하늘을 입에 담지 마라!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "요술에 현혹되지 마라. 목을 베면 술법도 끝난다."
        }
      ]
    },
    {
      "id": "04-zhangjue_turn6",
      "trigger": {
        "kind": "turn",
        "n": 6
      },
      "lines": [
        {
          "speaker": "장각",
          "side": "enemy",
          "text": "황천의 군세는 마르지 않는다. 나오라, 나의 형제들이여!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "끝이 없구나! ...좋다, 전부 상대해주마!"
        }
      ]
    },
    {
      "id": "duel_guanyu_youbi_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_guanyu_youbi"
      },
      "lines": [
        {
          "speaker": "유벽",
          "side": "enemy",
          "portraitId": "유벽",
          "text": "태평도의 분노를 받아라!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "portraitId": "관우",
          "text": "분노로는 청룡언월도를 못 이긴다."
        }
      ]
    },
    {
      "id": "04-zhangjue_retreat_장각",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "장각"
      },
      "lines": [
        {
          "speaker": "장각",
          "side": "enemy",
          "text": "황천은... 오지 않는가... 백성들의 하늘은, 어디에..."
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "...그 물음만은, 베어도 사라지지 않는구나."
        }
      ]
    },
    {
      "id": "04-zhangjue_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "관우",
          "side": "player",
          "text": "난의 우두머리가 쓰러졌습니다. 황건은 곧 흩어질 것입니다."
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "허나 세상은 아직 어둡다. ...가자, 다음 싸움터로."
        }
      ]
    }
