  "strategyConditions": [
    {
      "id": "duel_guanyu_caocao_reward",
      "description": "관우가 조조와 일기토를 벌여 그 목을 노리면 [의협교본]을 얻는다. 관우의 선택 — 1부 엔딩 분기의 씨앗.",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_guanyu_caocao"
      },
      "reward": {
        "treasures": [
          "의협교본"
        ],
        "gold": 800
      }
    }
  ],
  "dialogue": [
    {
      "id": "27-huarongdao_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "조조",
          "side": "enemy",
          "text": "화용의 좁은 길에서 만난 것이... 하필 그대인가, 관운장."
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "...승상. 군령이오. 여기서 목을 내놓으시오."
        },
        {
          "speaker": "조조",
          "side": "enemy",
          "text": "허창에서의 나날을 잊었는가. 금포도, 적토마도... 그대에게 건넨 정을."
        }
      ]
    },
    {
      "id": "27-huarongdao_turn4",
      "trigger": {
        "kind": "reinforcementArrived",
        "reinforcementId": "reinf_cao_rearguard_turn4"
      },
      "lines": [
        {
          "speaker": "허저",
          "side": "enemy",
          "text": "승상을 지켜라! 목숨을 걸어라!"
        }
      ]
    },
    {
      "id": "duel_guanyu_caocao_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_guanyu_caocao"
      },
      "lines": [
        {
          "speaker": "조조",
          "side": "enemy",
          "portraitId": "조조",
          "text": "운장... 옛 정을 기억하는가. 다섯 관문의 일을."
        },
        {
          "speaker": "관우",
          "side": "player",
          "portraitId": "관우",
          "text": "...기억하오. 그래서 더 괴롭소. 길을, 비키리다."
        }
      ]
    },
    {
      "id": "27-huarongdao_retreat_조조",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "조조"
      },
      "lines": [
        {
          "speaker": "조조",
          "side": "enemy",
          "text": "...가겠네, 운장. 이 빚은 언젠가 천하로 갚지."
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "...가시오. 군령을 어긴 죄는 — 이 목으로 받겠소."
        }
      ]
    },
    {
      "id": "27-huarongdao_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "관우",
          "side": "player",
          "text": "...형님, 저를 베어주십시오. 조조를... 놓아주었습니다."
        }
      ]
    }
  ],
