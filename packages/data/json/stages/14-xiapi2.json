        "lines": [
          {
            "speaker": "진등",
            "side": "player",
            "portraitId": "진등",
            "text": "주공, 조조군이 사수와 기수의 둑을 텄습니다. 물이 하비를 잠그면 — 여포의 기병은 관 속의 호랑이입니다.",
            "pose": [
              {
                "id": "liubei",
