              },
              {
                "id": "guanyu",
                "pose": "talk"
              }
            ]
          },
          {
            "speaker": "장비",
            "side": "player",
            "portraitId": "장비",
            "text": "여포 이놈, 드디어 목을 딸 날이 왔구나! 형님, 선봉은 나요!",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
