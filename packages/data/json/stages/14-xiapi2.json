          {
            "speaker": "관우",
            "side": "player",
            "portraitId": "관우",
            "text": "성안에선 진궁이 결사 항전을 외치고 있으나, 물이 차오르면 군심부터 가라앉지요.",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
              },
              {
                "id": "zhangfei",
                "pose": "idle"
              },
              {
