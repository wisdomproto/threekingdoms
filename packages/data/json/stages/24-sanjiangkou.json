            ],
            "facing": "right"
          },
          {
            "id": "zhouyu",
            "sprite": "zhouyu-robes",
            "cell": [
              7,
              3
            ],
            "facing": "left"
          },
          {
            "id": "zhugeliang",
            "sprite": "zhugeliang-robes",
            "cell": [
              7,
              5
            ],
            "facing": "left"
          }
        ],
        "lines": [
          {
            "speaker": "병사",
            "side": "player",
            "text": "이겼다! 조조의 수군도 물 위에선 별것 아니다!!",
            "pose": [
              {
                "id": "zhouyu",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "idle"
              },
              {
                "id": "soldier",
                "pose": "idle"
              }
            ],
            "bubble": {
              "id": "soldier",
              "mark": "!"
            }
          },
          {
            "speaker": "주유",
            "side": "ally",
            "portraitId": "주유",
            "text": "공명, 오늘은 뜻이 맞았소. 앞으로도 서로 맡은 일을 지켜 주기를 바라오.",
            "pose": [
              {
                "id": "soldier",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "idle"
              },
              {
                "id": "zhouyu",
                "pose": "talk"
              }
            ],
            "move": [
              {
                "id": "zhouyu",
                "to": [
                  6,
                  3
                ]
              }
            ]
          },
          {
            "speaker": "제갈량",
            "side": "player",
            "portraitId": "제갈량",
            "text": "화살과 군량부터 보충해야겠습니다. 큰 싸움은 아직 남았습니다.",
            "pose": [
              {
                "id": "soldier",
                "pose": "idle"
              },
              {
                "id": "zhouyu",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "salute"
              }
            ]
          },
          {
            "text": "승리한 진영에서도 준비는 멈추지 않았다. 제갈량은 부족한 화살을 사흘 안에 마련하겠다고 약속했다.",
            "pose": [
              {
                "id": "soldier",
                "pose": "idle"
              },
              {
                "id": "zhouyu",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "idle"
              }
            ]
          }
        ]
      },
      {
        "bg": "24-sanjiangkou-outro",
        "lines": [
          {
            "text": "화살을 마련하겠다고 약속한 제갈량은 첫날 아무것도 만들지 않았다. 둘째 날에도 대장간을 재촉하지 않았다. 노숙은 묻지 않으려 할수록 더 불안해졌다."
          },
          {
            "speaker": "노숙",
            "text": "기한을 어기면 주유 도독께서 그냥 넘기지 않을 것입니다.",
            "portraitId": "노숙"
          },
          {
            "speaker": "제갈량",
            "text": "압니다. 배와 사람을 빌려주신 일도 가볍게 여기지 않습니다.",
            "portraitId": "제갈량"
          },
          {
            "text": "셋째 날 새벽 강에 안개가 깔렸다. 짚을 세운 배가 물살을 탔고, 병사들은 적 앞에서 북을 치라는 명령을 받았다. 용기를 내라는 말보다 돌아갈 방향이 정해져 있다는 설명이 그들을 안심시켰다."
          },
          {
            "text": "화살이 박히는 소리가 비처럼 이어졌다. 제갈량은 배의 반대편을 돌리게 했다. 노숙은 그제야 이 사람이 기다린 것이 사흘이 아니라 어느 새벽의 강이라는 것을 알았다."
          },
          {
            "text": "돌아온 배에서 화살을 세는 동안 주유는 말을 아꼈다. 기쁜 일이었으나 기쁘기만 하지는 않았다. 함께 이겨야 할 사람의 재주가 훗날 자신의 길을 막을 수도 있었다."
          },
          {
            "text": "제갈량은 젖은 옷을 갈아입으러 갔다. 노숙은 화살보다 빌려 보낸 사람들이 모두 돌아왔는지 먼저 세었다."
          }
        ]
      }
    ]
  },
