  "dialogue": [
    {
      "id": "26-chibi_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "조조",
          "side": "enemy",
          "text": "백만 대군이 강을 덮었다. 강동도 형주도 — 오늘로 끝이다!"
        },
        {
          "speaker": "제갈량",
          "side": "player",
          "text": "동남풍은 이미 불기 시작했습니다. 주공 — 하늘이 우리 편입니다."
        },
        {
          "speaker": "주유",
          "side": "ally",
          "text": "전 함대, 화선(火船)을 앞세워라! 적벽을 불바다로!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "천하의 향방이 오늘 밤 갈린다. — 전군, 진격!"
        }
      ]
    },
    {
      "id": "26-chibi_turn4",
      "trigger": {
        "kind": "reinforcementArrived",
        "reinforcementId": "huangkai_fire_ships"
      },
      "lines": [
        {
          "speaker": "주유",
          "side": "ally",
          "text": "오군 본대 도착이다! 몰아쳐라!"
        }
      ]
    },
    {
      "id": "duel_guanyu_caoren_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_guanyu_caoren"
      },
      "lines": [
        {
          "speaker": "조인",
          "side": "enemy",
          "portraitId": "조인",
          "text": "불바다 속에서도 길을 연다!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "portraitId": "관우",
          "text": "그 길의 끝은 패주뿐이다."
        }
      ]
    },
    {
      "id": "duel_zhangfei_xuchu_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhangfei_xuchu"
      },
      "lines": [
        {
          "speaker": "허저",
          "side": "enemy",
          "portraitId": "허저",
          "text": "또 너냐!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "portraitId": "장비",
          "text": "이번엔 불까지 내 편이다!"
        }
      ]
    },
    {
      "id": "26-chibi_retreat_조인",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "조인"
      },
      "lines": [
        {
          "speaker": "조인",
          "side": "enemy",
          "text": "승상, 퇴로를! 퇴로를 여십시오!"
        }
      ]
    },
    {
      "id": "26-chibi_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "제갈량",
          "side": "player",
          "text": "적벽의 불은, 백 년이 지나도 이야기될 것입니다."
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "이겼다... 천하가 오늘 밤 바뀌었다."
        }
      ]
    },
    {
      "id": "campaign-fire-26-chibi-dialogue",
      "trigger": {
        "kind": "scriptFired",
        "scriptId": "campaign-fire-26-chibi"
      },
      "lines": [
        {
          "speaker": "조조",
          "side": "enemy",
          "portraitId": "조조",
          "text": "배가… 배가 불탄다! 사슬을 끊어라! 끊으란 말이다!"
        },
        {
          "speaker": "주유",
          "side": "ally",
          "portraitId": "주유",
          "text": "연결된 배에 화선이 닿았다! 불길에 갇힌 적을 몰아치되, 아군 함대는 거리를 벌려라!"
        }
      ]
    },
    {
      "id": "cao_rear_guard-dialogue",
      "trigger": {
        "kind": "reinforcementArrived",
        "reinforcementId": "cao_rear_guard"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "portraitId": "유비",
          "text": "조조군 후위대가 나타났다! 퇴로를 열어 주지 마라!"
        }
      ]
    }
  ],
