  "dialogue": [
    {
      "id": "08-dongzhuo-chase_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "text": "동탁이 멀지 않다. 복병을 경계하며 — 서둘러라!"
        },
        {
          "speaker": "이각",
          "side": "enemy",
          "text": "여기까지다. 승상께서 가신 길, 너희는 밟지 못한다!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "비켜라! 네놈들 상대할 시간도 아깝다!"
        }
      ]
    },
    {
      "id": "08-dongzhuo-chase_turn8",
      "trigger": {
        "kind": "turn",
        "n": 8
      },
      "lines": [
        {
          "speaker": "관우",
          "side": "player",
          "text": "시간이 없다. 잔적에 얽매이지 마라 — 뚫고 나간다!"
        }
      ]
    },
    {
      "id": "duel_zhangfei_lijue_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhangfei_lijue"
      },
      "lines": [
        {
          "speaker": "이각",
          "side": "enemy",
          "portraitId": "이각",
          "text": "동탁공을 쫓는 자, 누구냐!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "portraitId": "장비",
          "text": "장익덕이다! 길을 비켜라!"
        }
      ]
    },
    {
      "id": "08-dongzhuo-chase_retreat_이각",
      "trigger": {
