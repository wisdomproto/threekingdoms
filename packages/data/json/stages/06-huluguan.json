  "dialogue": [
    {
      "id": "06-huluguan_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "여포",
          "side": "enemy",
          "text": "호로관 앞에 선 것들이 너희냐. ...셋이 덤벼도 좋다, 마침 지루하던 참이다."
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "저 오만한 낯짝! 형님들, 저놈은 셋이서 잡읍시다!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "천하제일이라는 여포다. 흩어지면 죽는다 — 함께 싸운다!"
        }
      ]
    },
    {
      "id": "06-huluguan_turn5",
      "trigger": {
        "kind": "reinforcementArrived",
        "reinforcementId": "reinf_lubu_guards_turn5"
      },
      "lines": [
        {
          "speaker": "여포",
          "side": "enemy",
          "text": "동탁의 개들아, 구경만 할 셈이냐. 나와라!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "적 증원 — 허나 여포만 꺾으면 관문은 열린다!"
        }
      ]
    },
    {
      "id": "duel_zhangfei_lubu_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhangfei_lubu"
      },
      "lines": [
        {
          "speaker": "장비",
          "side": "player",
          "portraitId": "장비",
          "text": "여포! 이 장익덕과 한판 붙자!"
        },
        {
          "speaker": "여포",
          "side": "enemy",
          "portraitId": "여포",
          "text": "하룻강아지로군. 물러서라, 죽기 전에."
        }
      ]
    },
    {
      "id": "06-huluguan_retreat_여포",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "여포"
      },
      "lines": [
        {
          "speaker": "여포",
          "side": "enemy",
          "text": "...재미있는 놈들이다. 이 여포를 물러서게 하다니. 기억해두마 — 삼형제."
        }
      ]
    },
    {
      "id": "06-huluguan_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "장비",
          "side": "player",
          "text": "우리가... 여포를 밀어냈다! 크하하하!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "호로관이 열렸다. 낙양까지, 한걸음이다."
        }
      ]
    }
  ],
