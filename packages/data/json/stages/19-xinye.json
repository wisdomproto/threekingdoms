      }
    }
  ],
  "dialogue": [
    {
      "id": "19-xinye_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "조인",
          "side": "enemy",
          "text": "백성까지 끌고 가는 행군이 얼마나 가겠느냐. 전부 쓸어버려라!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "백성을 버리고 가는 길이라면, 천하도 필요 없다. — 모두 지킨다!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "text": "호위 진형을 유지하십시오. 한 사람도 빠뜨리지 않습니다."
        }
      ]
    },
    {
      "id": "19-xinye_turn4",
      "trigger": {
        "kind": "reinforcementArrived",
        "reinforcementId": "pursuit_vanguard"
      },
      "lines": [
        {
          "speaker": "조인",
          "side": "enemy",
          "text": "추격대 도착이다! 늦기 전에 물어라!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "적 추격대다 — 백성 곁을 떠나지 마라!"
        }
      ]
    },
    {
      "id": "duel_zhaoyun_caoren_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhaoyun_caoren"
      },
      "lines": [
        {
          "speaker": "조인",
          "side": "enemy",
          "portraitId": "조인",
          "text": "이 느림보 행렬, 짓밟아주마!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "portraitId": "조운",
          "text": "백성 앞을 지나려면 — 나를 먼저 넘어라."
        }
      ]
    },
    {
      "id": "19-xinye_retreat_조인",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "조인"
      },
      "lines": [
        {
          "speaker": "조인",
          "side": "enemy",
          "text": "백성을 방패로 삼는 게 아니라... 방패가 되어 싸우는가, 저들은..."
        }
      ]
    },
    {
      "id": "19-xinye_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "text": "모두 무사한가... 좋다. 걸음은 느려도, 함께 간다."
        }
      ]
    }
  ],
