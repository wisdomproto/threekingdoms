        "lines": [
          {
            "speaker": "제갈량",
            "side": "player",
            "portraitId": "제갈량",
            "text": "손권이 주유에게 수군 삼만을 주어 서진시켰습니다. 이제 조조와 싸울 '판'이 생겼습니다.",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
