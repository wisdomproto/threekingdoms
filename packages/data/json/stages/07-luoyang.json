  "dialogue": [
    {
      "id": "07-luoyang_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "이각",
          "side": "enemy",
          "text": "낙양은 이미 불바다다! 잿더미를 밟고 죽어라, 연합군!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "도성을 태우고 달아나는 것이 동탁의 대답인가... 용서할 수 없다."
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "불길 속에 백성이 있다. 길을 열며 나아간다!"
        }
      ]
    },
    {
      "id": "07-luoyang_turn5",
      "trigger": {
        "kind": "scriptFired",
        "scriptId": "campaign-fire-07-luoyang"
      },
      "lines": [
        {
          "speaker": "곽사",
          "side": "enemy",
          "portraitId": "곽사",
          "text": "시가지에 불을 놓았다! 골목으로 들어오는 놈들을 막아라!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "portraitId": "유비",
          "text": "불길이 번진다! 불붙은 구역을 피하고 백성의 퇴로부터 열어라!"
        }
      ]
    },
    {
      "id": "duel_guanyu_xurong_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_guanyu_xurong"
      },
      "lines": [
        {
          "speaker": "서영",
          "side": "enemy",
          "portraitId": "서영",
          "text": "낙양은 동탁공의 것이다!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "portraitId": "관우",
          "text": "잿더미를 두고 무슨 소유를 논하느냐."
        }
      ]
    },
    {
      "id": "07-luoyang_retreat_동탁",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "동탁"
      },
      "lines": [
        {
          "speaker": "동탁",
          "side": "enemy",
          "text": "장안으로! 옥새와 천자만 있으면 천하는 여전히 내 것이다!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "동탁이 달아난다...! 놓치지 마라!"
        }
      ]
    },
    {
      "id": "07-luoyang_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "text": "불은 잡았다. 허나 낙양은... 이미 폐허구나."
        }
      ]
    },
    {
      "id": "fire_rear_guard-dialogue",
