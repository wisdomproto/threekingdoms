                "pose": "idle"
              },
              {
                "id": "간옹",
                "pose": "idle"
              },
              {
                "id": "장비",
                "pose": "idle"
              }
            ]
          },
          {
            "speaker": "장비",
            "text": "그 골목에서 찾았소. 맞는 집인지는 모르겠소.",
