  "dialogue": [
    {
      "id": "18-bowangpo_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "하후돈",
          "side": "enemy",
          "text": "제갈량? 밭이나 갈던 촌부가 군사(軍師)라니, 웃음도 아깝다!"
        },
        {
          "speaker": "제갈량",
          "side": "player",
          "text": "바람의 길과 불의 길은 이미 정해두었습니다. — 주공, 적을 골짜기로."
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "군사의 첫 계략이다. 한 치의 어긋남 없이 움직여라!"
        }
      ]
    },
    {
      "id": "18-bowangpo_turn4",
      "trigger": {
        "kind": "turn",
        "n": 4
      },
      "lines": [
        {
          "speaker": "관우",
          "side": "player",
          "text": "복병, 지금입니다! 퇴로를 끊는다!"
        }
      ]
    },
    {
      "id": "18-bowangpo_turn6",
      "trigger": {
        "kind": "turn",
        "n": 6
      },
      "lines": [
        {
          "speaker": "하후돈",
          "side": "enemy",
          "text": "후군은 무얼 하느냐! 전부 밀어 넣어라!"
        }
      ]
    },
    {
      "id": "duel_guanyu_lidian_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_guanyu_lidian"
      },
      "lines": [
        {
          "speaker": "이전",
          "side": "enemy",
          "portraitId": "이전",
          "text": "복병이다! 물러서면 안 된다!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "portraitId": "관우",
          "text": "이미 늦었다. 골짜기가 곧 불바다가 되리라."
        }
      ]
    },
    {
      "id": "18-bowangpo_retreat_하후돈",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "하후돈"
      },
      "lines": [
        {
          "speaker": "하후돈",
          "side": "enemy",
          "text": "촌부의 불장난에... 이 하후돈이...!"
        },
        {
          "speaker": "제갈량",
          "side": "player",
          "text": "불은 계산대로 탔습니다. 남은 것은 바람이 거둘 것입니다."
        }
      ]
    },
    {
      "id": "18-bowangpo_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "장비",
          "side": "player",
          "text": "그 촌부 선생... 물건이구려, 형님!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "와룡이 날개를 폈다. 이제부터가 시작이다."
        }
      ]
    }
  ],
