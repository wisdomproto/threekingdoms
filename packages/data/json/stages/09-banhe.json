              "mark": "!"
            }
          },
          {
            "speaker": "유비",
            "side": "player",
            "portraitId": "유비",
            "text": "(눈빛이 맑고 곧다... 예사 장수가 아니구나.) 좋소, 젊은 장군. 측면을 부탁하오. 전군 — 반하를 건넌다!",
            "pose": [
              {
                "id": "zhangfei",
                "pose": "idle"
