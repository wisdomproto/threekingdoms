  "dialogue": [
    {
      "id": "09-banhe_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "국의",
          "side": "enemy",
          "text": "공손찬의 백마는 오늘 반하에 잠긴다! 활을 들어라!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "공손찬 님께 진 빚, 오늘 갚는다. 전군, 강을 등지지 마라!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "원소군이든 뭐든, 오는 놈은 전부 사모 밥이다!"
        }
      ]
    },
    {
      "id": "09-banhe_turn6",
      "trigger": {
        "kind": "turn",
        "n": 6
      },
      "lines": [
        {
          "speaker": "봉기",
          "side": "enemy",
          "text": "본대가 도착했다! 밀어붙여라!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "적 증원 — 당황하지 마라, 하나씩 벤다!"
        }
      ]
    },
    {
      "id": "duel_zhaoyun_juyi_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhaoyun_juyi"
      },
      "lines": [
        {
          "speaker": "국의",
          "side": "enemy",
          "portraitId": "국의",
          "text": "원소군의 선등사석을 뚫겠다고?"
        },
        {
          "speaker": "조운",
          "side": "player",
          "portraitId": "조운",
          "text": "사석진도, 한 점을 뚫으면 무너진다."
        }
      ]
    },
    {
      "id": "09-banhe_retreat_국의",
