              },
              {
                "id": "장비",
                "pose": "idle"
              }
            ]
          },
          {
            "speaker": "조운",
            "text": "그 말씀 때문에, 훗날 공을 찾을 수 있을 것 같습니다.",
            "portraitId": "조운",
            "pose": [
              {
