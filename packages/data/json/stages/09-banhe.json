        "lines": [
          {
            "text": "싸움 뒤 조운은 유비군의 부상자를 자기 말에 태웠다. 자신은 걸었다. 유비가 말을 바꿔 타라 하자, 상처 난 병사는 높이 오르내리기 어렵다고 했다.",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
              },
              {
                "id": "조운",
                "pose": "idle"
              },
              {
                "id": "관우",
                "pose": "idle"
              },
              {
                "id": "장비",
                "pose": "idle"
              }
            ]
          },
          {
            "speaker": "유비",
            "text": "자룡. 오늘 내 곁에 있었으면 하는 생각을 여러 번 했소.",
            "portraitId": "유비",
            "pose": [
              {
                "id": "유비",
                "pose": "talk"
              },
              {
                "id": "조운",
                "pose": "idle"
              },
              {
                "id": "관우",
                "pose": "idle"
              },
              {
                "id": "장비",
                "pose": "idle"
              }
            ]
          },
          {
            "speaker": "조운",
            "text": "저도 공의 군령을 더 듣고 싶었습니다.",
            "portraitId": "조운",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
              },
