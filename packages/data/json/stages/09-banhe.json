            ]
          },
          {
            "speaker": "유비",
            "text": "지금 그대가 선 자리를 가볍게 여기게 하고 싶지는 않소. 백규 형님의 은혜를 나도 입었으니.",
            "portraitId": "유비",
            "pose": [
              {
                "id": "유비",
                "pose": "talk"
              },
              {
                "id": "조운",
                "pose": "idle"
              },
