                ]
              }
            ],
            "text": "두 사람은 어깨를 나란히 하고 저잣거리 모퉁이 주점으로 향했다.",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
              },
              {
                "id": "zhangfei",
                "pose": "idle"
              }
            ]
          }
        ]
