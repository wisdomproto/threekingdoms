            ],
            "bubble": {
              "id": "zhangfei",
              "mark": "!"
            },
            "speaker": "장비",
            "portraitId": "장비",
            "side": "player",
            "text": "호오, 의병이라 하셨소? 여기도 같은 길을 가려는 사람이 둘이나 있소! 통성명이나 합시다!",
            "pose": [
              {
                "id": "liubei",
                "pose": "sit"
              },
              {
                "id": "zhangfei",
                "pose": "sit-talk"
              },
              {
