  "dialogue": [
    {
      "id": "01-zhuojun_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "정원지",
          "side": "enemy",
          "text": "웬 잡졸들이냐. 짚신이나 삼던 것들이 창을 들었구나!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "잡졸? 연인 장익덕의 사모가 네놈 목부터 물어주마!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "의병들이여 — 등 뒤가 곧 고향이다. 물러설 땅은 없다, 진격하라!"
        }
      ]
    },
    {
      "id": "01-zhuojun_turn3",
      "trigger": {
        "kind": "turn",
        "n": 3
      },
      "lines": [
        {
          "speaker": "관우",
          "side": "player",
          "text": "적진이 흐트러진다. 지금이다 — 몰아붙여라!"
        },
        {
          "speaker": "정원지",
          "side": "enemy",
          "text": "무, 무엇이냐 이 기세는...!"
        }
      ]
    },
    {
      "id": "01-zhuojun_retreat_정원지",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "정원지"
      },
      "lines": [
        {
          "speaker": "정원지",
          "side": "enemy",
          "text": "이런 촌구석에... 이런 자들이 있었단 말이냐...!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "크하하! 꽁무니 빼는 꼴 좀 보시오, 형님!"
        }
      ]
    },
    {
      "id": "01-zhuojun_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "text": "끝났다. ...모두, 잘 싸워 주었다."
        }
      ]
    }
