  "dialogue": [
    {
      "id": "25-wulin_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "조조",
          "side": "enemy",
          "text": "황개의 항복선이 온다 들었다. ...헌데 저 불빛은 무엇이냐."
        },
        {
          "speaker": "황개",
          "side": "ally",
          "text": "고육(苦肉)의 살값, 오늘 받으러 왔다! 불을 놓아라!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "오림이 불탄다 — 우리도 뭍에서 몰아친다!"
        }
      ]
    },
    {
      "id": "25-wulin_turn4",
      "trigger": {
        "kind": "turn",
        "n": 4
      },
      "lines": [
        {
          "speaker": "황개",
          "side": "ally",
          "text": "오군 본대가 왔다! 조조의 퇴로를 끊어라!"
        }
      ]
    },
    {
      "id": "duel_huanggai_caimao_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_huanggai_caimao"
      },
      "lines": [
        {
          "speaker": "채모",
          "side": "enemy",
          "portraitId": "채모",
          "text": "또 너냐, 황공복!"
        },
        {
          "speaker": "황개",
          "side": "ally",
          "portraitId": "황개",
          "text": "이번엔 불을 안고 왔다."
        }
      ]
    },
    {
      "id": "25-wulin_retreat_채모",
