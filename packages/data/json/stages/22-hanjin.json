            ],
            "facing": "right"
          },
          {
            "id": "guanyu",
            "sprite": "guanyu-leader",
            "cell": [
              3,
              5
            ],
            "facing": "right",
            "hidden": true
          },
          {
            "id": "zhangfei",
            "sprite": "zhangfei-leader",
            "cell": [
              7,
              5
            ],
            "facing": "left"
          },
          {
            "id": "zhugeliang",
            "sprite": "zhugeliang-robes",
            "cell": [
              7,
              3
            ],
            "facing": "left"
          }
        ],
        "lines": [
          {
            "speaker": "장비",
            "side": "player",
            "portraitId": "장비",
            "text": "젠장, 뒤에는 추격병, 앞에는 강물이라! 하늘이 우리를 버리는 게요?!",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "idle"
              },
              {
                "id": "zhangfei",
                "pose": "talk"
              }
            ],
            "bubble": {
              "id": "zhangfei",
              "mark": "!"
            }
          },
          {
            "text": "그때 — 강 위에서 북소리가 울렸다. 돛대마다 '관(關)' 자 깃발을 단 선단이 물살을 가르며 다가오고 있었다.",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
              },
              {
                "id": "zhangfei",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "idle"
              }
            ]
          },
          {
            "speaker": "관우",
            "side": "player",
            "portraitId": "관우",
            "text": "형님! 강하의 수군을 이끌고 마중 나왔습니다. 어서 배에 오르십시오!",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
              },
              {
                "id": "zhangfei",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "idle"
              },
              {
                "id": "guanyu",
                "pose": "salute"
              }
            ],
            "enter": [
              {
                "id": "guanyu",
                "from": [
                  10,
                  5
                ],
                "to": [
                  3,
                  5
                ]
              }
            ],
            "face": [
              {
                "id": "guanyu",
                "dir": "right"
              }
            ]
          },
          {
            "speaker": "유비",
            "side": "player",
            "portraitId": "유비",
            "text": "운장...! 또 한 번 네 덕에 산다. 백성들을 먼저 태워라!",
            "pose": [
              {
                "id": "guanyu",
                "pose": "idle"
              },
              {
                "id": "zhangfei",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "idle"
              },
              {
                "id": "liubei",
                "pose": "salute"
              }
            ],
            "bubble": {
              "id": "liubei",
              "mark": "!"
            }
          },
          {
            "speaker": "제갈량",
            "side": "player",
            "portraitId": "제갈량",
            "text": "조조의 추격은 여기까지입니다. 강을 건너면 — 이제 동오와 천하의 판을 짤 차례지요.",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
              },
              {
                "id": "guanyu",
                "pose": "idle"
              },
              {
                "id": "zhangfei",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "talk"
              }
            ]
          }
        ]
      }
    ],
    "outro": [
      {
        "bg": "22-hanjin-outro",
        "lines": [
          {
            "text": "배가 강심에 이르자 추격군의 함성이 멀어졌다. 백성들이 뱃전에 엎드려 울며 절했다."
          }
        ]
      },
      {
        "map": "scene-command-deck",
        "label": "함상 · 강동으로",
        "camera": {
          "zoom": 1.3,
          "focus": [
            5,
            4
          ]
        },
        "units": [
          {
            "id": "liubei",
            "sprite": "liubei-leader",
            "cell": [
              4,
              4
            ],
            "facing": "right"
          },
          {
            "id": "zhugeliang",
            "sprite": "zhugeliang-robes",
            "cell": [
              7,
              4
            ],
            "facing": "left"
          }
        ],
        "lines": [
          {
            "speaker": "유비",
            "side": "player",
            "portraitId": "유비",
            "text": "겨우 한숨 돌리는구나. 군사, 정말 손권과 손잡을 수 있겠소?",
            "pose": [
              {
                "id": "zhugeliang",
                "pose": "idle"
              },
              {
                "id": "liubei",
                "pose": "idle"
              }
            ],
            "bubble": {
              "id": "liubei",
              "mark": "?"
            }
          },
          {
            "speaker": "제갈량",
            "side": "player",
            "portraitId": "제갈량",
            "text": "맡겨 주십시오. 제가 직접 강동으로 건너가 — 천하를 셋으로 나눌 판을 짜겠습니다.",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "salute"
              }
            ]
          },
          {
            "text": "작은 배 한 척이 남쪽으로 떠났다. 세 치 혀에 천하의 향배를 싣고.",
            "pose": [
              {
                "id": "liubei",
                "pose": "idle"
              },
              {
                "id": "zhugeliang",
                "pose": "idle"
              }
            ],
            "exit": [
              {
                "id": "zhugeliang",
                "to": [
                  1,
                  4
                ]
              }
            ]
          }
        ]
      },
      {
        "map": "scene-river-landing",
        "label": "건너온 사람의 숫자",
        "camera": {
          "zoom": 1.3
        },
        "units": [
          {
            "id": "유비",
            "sprite": "liubei-foot",
            "cell": [
              4,
              4
            ],
            "facing": "right"
          },
          {
            "id": "관우",
            "sprite": "guanyu-foot",
            "cell": [
              7,
              4
            ],
            "facing": "left"
          },
          {
            "id": "미축",
            "sprite": "mizhu-robes",
            "cell": [
              5,
              5
            ],
            "facing": "left"
          }
        ],
        "lines": [
          {
            "text": "관우는 배 위에서 형을 알아보았다. 두 사람은 손을 들어 보였지만 곧 각자 명령을 내렸다. 재회는 승선이 끝난 뒤에 해도 늦지 않았다.",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
              },
              {
                "id": "관우",
                "pose": "idle"
              },
              {
                "id": "미축",
                "pose": "idle"
              }
            ]
          },
          {
            "text": "미축은 아이와 부상자부터 태웠다. 자기 짐을 내려야 하는 사람들이 항의했고, 이미 짐을 버린 사람들이 그들을 설득했다.",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
              },
              {
                "id": "관우",
                "pose": "idle"
              },
              {
                "id": "미축",
                "pose": "idle"
              }
            ],
            "move": [
              {
                "id": "미축",
                "to": [
                  6,
                  5
                ]
              }
            ]
          },
          {
            "text": "유비가 마지막 배에 오를 때 강가에는 빈 자루들이 남았다. 사람들이 끝까지 가져오려 했던 것의 자국이었다. 물결이 닿으면 조금씩 젖어 무거워졌다.",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
              },
              {
                "id": "관우",
                "pose": "idle"
              },
              {
                "id": "미축",
                "pose": "idle"
              }
            ]
          },
          {
            "speaker": "관우",
            "text": "늦지 않았소?",
            "portraitId": "관우",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
              },
              {
                "id": "관우",
                "pose": "talk"
              },
              {
                "id": "미축",
                "pose": "idle"
              }
            ]
          },
          {
            "speaker": "유비",
            "text": "와 주었소. 그 말을 먼저 하겠소.",
            "portraitId": "유비",
            "pose": [
              {
                "id": "유비",
                "pose": "talk"
              },
              {
                "id": "관우",
                "pose": "idle"
              },
              {
                "id": "미축",
                "pose": "idle"
              }
            ]
          },
          {
            "text": "밤에 배 안에서 사람을 셌다. 출발할 때의 숫자와 맞지 않았다. 간옹은 틀린 셈인지 잃은 사람인지 알아내기 위해 다시 셌다.",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
              },
              {
                "id": "관우",
                "pose": "idle"
              },
              {
                "id": "미축",
                "pose": "idle"
              }
            ],
            "face": [
              {
                "id": "유비",
                "dir": "down"
              }
            ]
          },
          {
            "text": "유비는 두 번째 셈도 끝날 때까지 기다렸다. 강을 건넌 사람들에게는 밥을 주고, 건너지 못한 이름을 위해서는 등불을 하나 더 켰다.",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
              },
              {
                "id": "관우",
                "pose": "idle"
              },
              {
                "id": "미축",
                "pose": "idle"
              }
            ]
          }
        ]
      }
    ]
