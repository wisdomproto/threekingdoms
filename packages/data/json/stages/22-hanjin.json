  "dialogue": [
    {
      "id": "22-hanjin_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "하후돈",
          "side": "enemy",
          "text": "강가에 몰렸구나, 유비! 이제 달아날 곳은 물속뿐이다!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "하늘이 나를 여기서 거두려는가...!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "text": "아직입니다, 주공. — 저 물길은, 원군의 길이기도 합니다."
        }
      ]
    },
    {
      "id": "22-hanjin_turn4",
      "trigger": {
        "kind": "turn",
        "n": 4
      },
      "lines": [
        {
          "speaker": "관우",
          "side": "player",
          "text": "형님!! 강하의 배가 왔습니다 — 관우, 지금 갑니다!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "둘째 형님이다! 크하하, 이제 반격이다!"
        }
      ]
    },
    {
      "id": "duel_zhaoyun_xiahouen_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhaoyun_xiahouen"
      },
      "lines": [
        {
          "speaker": "하후은",
          "side": "enemy",
          "portraitId": "하후은",
          "text": "나루를 막아라!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "portraitId": "조운",
          "text": "주공을 건너게 하라 — 후미는 내가 맡는다."
        }
      ]
    },
    {
      "id": "22-hanjin_retreat_하후돈",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "하후돈"
      },
      "lines": [
        {
          "speaker": "하후돈",
          "side": "enemy",
          "text": "관우까지 왔는가... 물가의 싸움은 불리하다. 물러난다!"
        }
      ]
    },
    {
      "id": "22-hanjin_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "text": "운장... 살아 있었구나. 하늘은 아직 우리를 버리지 않았다."
        }
      ]
    }
