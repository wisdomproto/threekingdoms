                "pose": "idle"
              }
            ]
          },
          {
            "speaker": "유비",
            "side": "player",
            "portraitId": "유비",
            "text": "밤을 새워서라도 간다. 영천이 뚫리면 다음은 낙양이다.",
            "pose": [
              {
