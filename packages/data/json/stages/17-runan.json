      },
      "lines": [
        {
          "speaker": "허저",
          "side": "enemy",
          "portraitId": "허저",
          "text": "또 너냐, 상산의 조자룡!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "portraitId": "조운",
          "text": "주공께 가는 길, 누구도 못 막는다."
