  "dialogue": [
    {
      "id": "17-runan_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "허저",
          "side": "enemy",
          "text": "여남의 잔당들, 그리고 유비! 오늘로 끝을 내주마!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "아우들과 다시 만난 이 날 — 물러설 수는 없다!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "형님 곁에 다시 섰습니다. 이 청룡도, 두 번 다시 헤어지지 않습니다."
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "삼형제가 다시 모였다! 천하에 두려울 게 뭐냐!"
        }
      ]
    },
    {
      "id": "17-runan_turn6",
      "trigger": {
        "kind": "turn",
        "n": 6
      },
      "lines": [
        {
          "speaker": "조인",
          "side": "enemy",
          "text": "포위하라! 이번에야말로 유비의 목을 조공께 바친다!"
        }
      ]
    },
    {
      "id": "duel_zhaoyun_xuchu_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhaoyun_xuchu"
      },
      "lines": [
        {
          "speaker": "허저",
          "side": "enemy",
          "portraitId": "허저",
          "text": "또 너냐, 상산의 조자룡!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "portraitId": "조운",
          "text": "주공께 가는 길, 누구도 못 막는다."
        }
      ]
    },
    {
      "id": "17-runan_retreat_허저",
