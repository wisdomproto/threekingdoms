  "dialogue": [
    {
      "id": "20-changbanpo_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "조순",
          "side": "enemy",
          "text": "홀몸의 적장이다! 에워싸라 — 공을 세울 기회다!"
        },
        {
          "speaker": "조운",
