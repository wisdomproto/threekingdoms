  "dialogue": [
    {
      "id": "20-changbanpo_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "조순",
          "side": "enemy",
          "text": "홀몸의 적장이다! 에워싸라 — 공을 세울 기회다!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "text": "상산 조자룡이다. 공자의 길을 막는 자는, 누구든 벤다."
        }
      ]
    },
    {
      "id": "20-changbanpo_turn4",
      "trigger": {
        "kind": "turn",
        "n": 4
      },
      "lines": [
        {
          "speaker": "하후돈",
          "side": "enemy",
          "text": "저 한 놈을 못 잡아 이 소란이냐! 조공께서 보고 계신다!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "text": "포위가 두터워진다... 허나 멈추면 끝이다. 뚫는다!"
        }
      ]
    },
    {
      "id": "20-changbanpo_turn8",
      "trigger": {
        "kind": "turn",
        "n": 8
      },
      "lines": [
        {
          "speaker": "조운",
          "side": "player",
          "text": "적이 또 늘어난다 — 공자, 조금만 더 견디십시오...!"
        }
      ]
    },
    {
      "id": "duel_zhaoyun_xiahouen_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhaoyun_xiahouen"
      },
      "lines": [
        {
          "speaker": "하후은",
          "side": "enemy",
          "portraitId": "하후은",
          "text": "혼자서 무얼 하겠다고!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "portraitId": "조운",
          "text": "공자를 품에 안고도, 네놈들 백을 벤다. 그 검, 내가 받아가마."
        }
      ]
    },
    {
      "id": "20-changbanpo_retreat_조순",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "조순"
      },
      "lines": [
        {
          "speaker": "조순",
          "side": "enemy",
          "text": "괴, 괴물이냐, 저자는...!"
        }
      ]
    },
    {
      "id": "20-changbanpo_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
