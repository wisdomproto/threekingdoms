        "lines": [
          {
            "text": "광종성 아래. 성벽 위에 누런 깃발이 빽빽하고, 바람에 매캐한 향 연기가 실려 왔다 — 장보의 요술이 시작된 것이다.",
            "pose": [
              {
                "id": "liu",
                "pose": "idle"
              },
              {
                "id": "guan",
                "pose": "idle"
              },
              {
                "id": "zhang",
                "pose": "idle"
              }
            ],
            "face": [
              {
                "id": "liu",
