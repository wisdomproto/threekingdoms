              },
              {
                "id": "guan",
                "dir": "up"
              },
              {
                "id": "zhang",
                "dir": "up"
              }
            ]
          },
          {
            "speaker": "장비",
            "side": "player",
            "portraitId": "장비",
            "text": "성문 걸어 잠그고 향불 피우며 요술 나부랭이라... 사내답지 못한 놈이구려!",
            "pose": [
              {
                "id": "liu",
                "pose": "idle"
              },
              {
                "id": "guan",
                "pose": "idle"
              },
              {
                "id": "zhang",
                "pose": "emphasize"
              }
            ]
          },
          {
            "speaker": "관우",
            "side": "player",
            "portraitId": "관우",
            "text": "요술은 눈을 속일 뿐, 성벽을 지켜주진 못한다. 성문을 깨면 농성도 끝이다.",
            "pose": [
              {
                "id": "liu",
                "pose": "idle"
              },
              {
                "id": "zhang",
                "pose": "idle"
              },
              {
                "id": "guan",
                "pose": "talk"
              }
            ]
          },
          {
            "speaker": "유비",
            "side": "player",
            "portraitId": "유비",
            "text": "성문을 열어젖히고 장보를 잡는다. 헛것에 현혹되지 마라 — 우리가 봐야 할 것은 백성의 내일이다.",
            "pose": [
              {
                "id": "guan",
                "pose": "idle"
              },
              {
                "id": "zhang",
                "pose": "idle"
              },
              {
                "id": "liu",
                "pose": "emphasize"
              }
            ]
          }
        ]
