              "mark": "!"
            }
          },
          {
            "speaker": "유비",
            "side": "player",
            "portraitId": "유비",
            "text": "백규 형님! 스승님의 부름이라면 물을 것도 없지요. 아우들아, 광종으로 간다.",
            "pose": [
              {
                "id": "guan",
                "pose": "idle"
              },
              {
                "id": "zhang",
                "pose": "idle"
              },
              {
