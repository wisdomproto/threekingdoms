            ]
          },
          {
            "speaker": "공손찬",
            "side": "ally",
            "portraitId": "공손찬",
            "text": "현덕! 이게 몇 해 만인가. 노식 장군의 격문일세 — 광종에 틀어박힌 장보를 친다. 함께 가세.",
            "pose": [
              {
                "id": "liu",
                "pose": "idle"
              },
              {
                "id": "guan",
                "pose": "idle"
              },
              {
                "id": "zhang",
                "pose": "idle"
              },
              {
                "id": "gong",
                "pose": "salute"
              }
            ],
            "bubble": {
