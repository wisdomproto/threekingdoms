  "dialogue": [
    {
      "id": "10-xuzhou_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "하후돈",
          "side": "enemy",
          "text": "서주는 조공의 원수의 땅이다. 성도 사람도 남기지 말라는 군령이시다!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "학살을 군령이라 부르지 마라! 서주의 백성은 우리가 지킨다!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "조조군의 창끝이 매섭습니다. 형님 — 한 발도 물릴 수 없습니다."
        }
      ]
    },
    {
      "id": "10-xuzhou_turn6",
      "trigger": {
        "kind": "reinforcementArrived",
        "reinforcementId": "reinforce_taishici"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "text": "도겸 공의 원군이다! 기세를 올려라!"
        }
      ]
    },
    {
      "id": "duel_guanyu_yujin_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_guanyu_yujin"
      },
      "lines": [
        {
          "speaker": "우금",
          "side": "enemy",
          "portraitId": "우금",
          "text": "서주는 조조공의 복수가 닿는 땅!"
        },
        {
          "speaker": "관우",
          "side": "player",
          "portraitId": "관우",
          "text": "복수에 백성을 끌어들이는 건 대장부가 아니다."
        }
      ]
    },
    {
      "id": "10-xuzhou_retreat_하후돈",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "하후돈"
      },
      "lines": [
        {
          "speaker": "하후돈",
          "side": "enemy",
          "text": "유비... 그 이름, 조공께 전해두마."
        }
      ]
    },
    {
      "id": "10-xuzhou_victory",
