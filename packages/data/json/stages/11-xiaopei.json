  "dialogue": [
    {
      "id": "11-xiaopei_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "여포",
          "side": "enemy",
          "text": "은혜를 원수로 갚느냐는 얼굴이군. — 천하에 은혜 따위는 없다, 유비."
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "머물 곳을 내어준 손을 무는가, 여포!"
        },
        {
          "speaker": "장비",
          "side": "player",
          "text": "이 배은망덕한 놈! 소패는 못 내준다!"
        }
      ]
    },
    {
      "id": "11-xiaopei_turn4",
      "trigger": {
        "kind": "reinforcementArrived",
        "reinforcementId": "reinf_gaoshun_vanguard_turn4"
      },
      "lines": [
        {
          "speaker": "고순",
          "side": "enemy",
          "text": "함진영(陷陣營), 돌격한다. 진을 부숴라."
        },
        {
          "speaker": "관우",
          "side": "player",
          "text": "적의 예봉이 온다 — 물러서지 마라!"
        }
      ]
    },
    {
      "id": "duel_guanyu_zhangliao_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_guanyu_zhangliao"
      },
      "lines": [
        {
          "speaker": "장요",
          "side": "enemy",
          "portraitId": "장요",
          "text": "관운장... 그대와는 겨루고 싶지 않으나."
        },
        {
          "speaker": "관우",
          "side": "player",
          "portraitId": "관우",
          "text": "장문원, 훗날 같은 깃발 아래 서기를 바라네."
        }
      ]
    },
    {
      "id": "11-xiaopei_retreat_여포",
      "trigger": {
        "kind": "unitRetreated",
        "unitId": "여포"
      },
      "lines": [
        {
          "speaker": "여포",
          "side": "enemy",
          "text": "쳇... 오늘은 여기까지다. 소패쯤, 언제든 밟아주마."
        }
      ]
    },
    {
      "id": "11-xiaopei_victory",
      "trigger": {
        "kind": "battleEnd",
        "result": "victory"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "text": "물러갔다... 허나 여포가 있는 한, 서주에 평온은 없다."
        }
      ]
    },
    {
      "id": "reinf_lubu_press_turn7-dialogue",
      "trigger": {
        "kind": "reinforcementArrived",
        "reinforcementId": "reinf_lubu_press_turn7"
      },
      "lines": [
        {
          "speaker": "유비",
          "side": "player",
          "portraitId": "유비",
          "text": "여포군의 후속 부대가 온다! 소패의 방어선을 지켜라!"
        }
      ]
    }
