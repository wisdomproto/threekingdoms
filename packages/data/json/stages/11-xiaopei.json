              {
                "id": "장비",
                "pose": "kneel"
              }
            ]
          },
          {
            "speaker": "장비",
            "text": "성도, 형수님들도…… 내가 맡은 것을 하나도 지키지 못했소.",
            "portraitId": "장비",
            "pose": [
              {
                "id": "유비",
                "pose": "idle"
