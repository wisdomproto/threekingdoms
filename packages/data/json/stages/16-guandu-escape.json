  "dialogue": [
    {
      "id": "16-guandu-escape_battle_start",
      "trigger": {
        "kind": "battleStart"
      },
      "lines": [
        {
          "speaker": "조인",
          "side": "enemy",
          "text": "원소에게 붙었던 죄 — 여기서 갚아라, 유비!"
        },
        {
          "speaker": "유비",
          "side": "player",
          "text": "천하가 뒤집히는 싸움터다. 휘말리면 끝 — 길을 연다!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "text": "주공, 제가 앞장서겠습니다. 창끝이 향하는 곳이 곧 길입니다."
        }
      ]
    },
    {
      "id": "16-guandu-escape_turn5",
      "trigger": {
        "kind": "turn",
        "n": 5
      },
      "lines": [
        {
          "speaker": "허저",
          "side": "enemy",
          "text": "도망치는 등짝은 베기 쉽지!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "text": "뒤는 제게 맡기고 달리십시오!"
        }
      ]
    },
    {
      "id": "duel_zhaoyun_xuchu_dialogue",
      "trigger": {
        "kind": "duelOccurred",
        "duelId": "duel_zhaoyun_xuchu"
      },
      "lines": [
        {
          "speaker": "허저",
          "side": "enemy",
          "portraitId": "허저",
          "text": "어딜 달아나느냐!"
        },
        {
          "speaker": "조운",
          "side": "player",
          "portraitId": "조운",
          "text": "달아나는 게 아니라 — 길을 여는 것이다."
        }
      ]
    },
    {
      "id": "16-guandu-escape_retreat_조인",
