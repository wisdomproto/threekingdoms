# apps/web 환경변수 예시 — 이 파일을 .env.local 로 복사(.env.local은 git 추적 안 됨).

# 에셋 서빙 베이스 URL (CLAUDE.md §3 R2/CDN).
#  - 비워두면 apps/web/public 에서 동일출처 로드(dev 기본).
#  - prod에서 R2 커스텀 도메인으로 전환:  https://cdn.example.com  (끝 슬래시 없이)
#    → assetUrl()이 "/assets/..." 앞에 붙여 전부 R2/CDN을 탄다.
#  - Vercel 배포 시에는 이 값을 Vercel 프로젝트 Environment Variables 에 동일하게 설정.
NEXT_PUBLIC_ASSET_BASE=

# 광고 공급자 (CLAUDE.md §13 — 포털 우선). 빌드별 env로 "그 포털 광고만" 규칙 준수.
#  - 미설정/stub → DevMock(가짜 광고 모달, 자체 도메인·개발 기본). 실 SDK 로드 안 함.
#  - poki | crazygames | gd → 해당 포털 SDK 어댑터가 붙는다(adProviders/).
#  포털 제출 빌드 예:  NEXT_PUBLIC_AD_PROVIDER=crazygames pnpm --filter @tk/web build
NEXT_PUBLIC_AD_PROVIDER=

# GameDistribution 전용 — 콘솔에서 게임 등록 후 발급되는 gameId. gd 공급자일 때 필수.
NEXT_PUBLIC_GD_GAME_ID=

# 도구 서버(tools/serve.py) origin — dev 전투 일시정지 메뉴의 「✏ 이 스테이지 편집」이 여는 에디터 주소.
#  launch.json "tools" 항목 = 8081. 코드 기본값도 동일(미설정 시 http://localhost:8081). 프로덕션엔 무영향(버튼 미표시).
NEXT_PUBLIC_TOOLS_ORIGIN=http://localhost:8081
